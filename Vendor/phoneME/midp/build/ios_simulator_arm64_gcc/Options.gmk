include ../linux_fb_gcc/Options.gmk

USE_IOS_NATIVE = true
SUBSYSTEM_LCDUI_MODULES = platform_widget
USE_SDL3 = false

IOS_DEPLOYMENT_TARGET ?= 16.0
IOS_SDKROOT := $(shell xcrun --sdk iphonesimulator --show-sdk-path)
IOS_TARGET_FLAGS := \
    -target arm64-apple-ios$(IOS_DEPLOYMENT_TARGET)-simulator \
    -isysroot $(IOS_SDKROOT) \
    -mios-simulator-version-min=$(IOS_DEPLOYMENT_TARGET)
CMDLINE_CFLAGS += $(IOS_TARGET_FLAGS) -DPHONEME_IOS_NATIVE=1 \
    -Werror=pointer-to-int-cast \
    -Werror=int-to-pointer-cast \
    -Werror=void-pointer-to-int-cast \
    -Werror=int-to-void-pointer-cast \
    -Werror=format
LD_FLAGS += $(IOS_TARGET_FLAGS)
USE_RFB = false
USE_DIRECTFB = false

# Match device runtime behavior and avoid debug interpreter overhead in games.
USE_DEBUG = false
USE_CLDC_RELEASE = true
DISABLE_WERROR = true
USE_WEAK_GCC_WARNINGS = true
USE_MULTIPLE_ISOLATES = true
USE_NATIVE_APP_MANAGER = true
USE_AUTOTESTER = false
USE_SPLIT_PREVERIFY = true
USE_MIDP_ROM = false
CONFIGURATION_OVERRIDE =
