# iOS font.bin bitmap renderer with CoreText fallback for missing glyphs.

PUTPIXEL_PORT_IOS_NATIVE_DIR = $(SUBSYSTEM_LOWUI_DIR)/putpixel_port/ios_native

vpath % $(PUTPIXEL_PORT_IOS_NATIVE_DIR)/native

SUBSYSTEM_GRAPHICS_EXTRA_INCLUDES += \
    -I$(PUTPIXEL_PORT_IOS_NATIVE_DIR)/include

SUBSYSTEM_GRAPHICS_NATIVE_FILES += \
    gxjport_text.c
