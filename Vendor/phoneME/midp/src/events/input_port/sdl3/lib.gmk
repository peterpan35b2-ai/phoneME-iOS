# SDL3 keyboard and pointer input paired with the SDL3 framebuffer port.

SDL3_INPUT_DIR=$(SUBSYSTEM_EVENTS_DIR)/input_port/sdl3
SDL3_FB_PORT_DIR=$(SUBSYSTEM_DIR)/highlevelui/fb_port/sdl3

vpath % $(SDL3_INPUT_DIR)/native

SUBSYSTEM_EVENTS_NATIVE_FILES += \
    sdl3_handle_input.c

SUBSYSTEM_EVENTS_EXTRA_INCLUDES += \
    -I$(SDL3_INPUT_DIR)/native \
    -I$(SDL3_FB_PORT_DIR)/native
