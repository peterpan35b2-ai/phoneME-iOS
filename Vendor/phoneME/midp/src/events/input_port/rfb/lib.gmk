# Remote input implementation paired with the LibVNCServer framebuffer port.

RFB_INPUT_DIR=$(SUBSYSTEM_EVENTS_DIR)/input_port/rfb
RFB_FB_PORT_DIR=$(SUBSYSTEM_DIR)/highlevelui/fb_port/rfb

vpath % $(RFB_INPUT_DIR)/native

SUBSYSTEM_APP_NATIVE_FILES += \
    rfb_handle_input.c

SUBSYSTEM_EVENTS_EXTRA_INCLUDES += \
    -I$(RFB_INPUT_DIR)/native \
    -I$(RFB_FB_PORT_DIR)/native
