######################################################################
#
# Module's Component Configuration file
#
# Remember: It is up to the module itself to impose rules of
# how to compile the options. All the global Makefile needs
# is the final def. of Java and native file lists and some
# other def. (like VPATH)
######################################################################

# Adds to global SUBSYSTEMS list
#
SUBSYSTEM_MEDIA = media

SUBSYSTEMS += $(SUBSYSTEM_MEDIA)

# Javadoc source path
SUBSYSTEM_MEDIA_SOURCEPATH += $(SUBSYSTEM_DIR)/media/reference/classes

SUBSYSTEM_MEDIA_PACKAGES = \
    javax.microedition.media javax.microedition.media.control \
    javax.microedition.media.protocol

MIDP_JAVADOC_SOURCEPATH += $(SUBSYSTEM_MEDIA_SOURCEPATH)
MIDP_JAVADOC_PACKAGES +=  $(SUBSYSTEM_MEDIA_PACKAGES)

MIDP_JAVADOC_ALL += \
        -group "Media stuff" \
	$(shell echo $(SUBSYSTEM_MEDIA_PACKAGES)|tr ' ' $(PATHSEP))

# There are no modules for subsystem ( media )
#

# vpath for the iOS media backend.
#
vpath % $(SUBSYSTEM_DIR)/media/ios_native/native

# Java files for the ( media ) subsystem
#
SUBSYSTEM_MEDIA_JAVA_FILES += \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/Control.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/Controllable.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/IOSPlayer.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/Manager.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/MediaException.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/Player.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/PlayerListener.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/TimeBase.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/FramePositioningControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/GUIControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/MetaDataControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/MIDIControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/PitchControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/RateControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/RecordControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/StopTimeControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/TempoControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/ToneControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/VideoControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/control/VolumeControl.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/protocol/ContentDescriptor.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/protocol/DataSource.java \
     $(SUBSYSTEM_DIR)/media/reference/classes/javax/microedition/media/protocol/SourceStream.java

# Native files for the iOS media backend. The KNI shim is built into the
# phoneME archive; AVFoundation itself lives in the app-side Objective-C bridge.
#
ifeq ($(USE_IOS_NATIVE), true)
SUBSYSTEM_MEDIA_EXTRA_INCLUDES += \
    -I$(SUBSYSTEM_DIR)/core/kni_util/include
SUBSYSTEM_MEDIA_NATIVE_FILES += \
    ios_media_kni.c
endif


