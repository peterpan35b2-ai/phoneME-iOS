# Minimal JSR-120 public interfaces needed to link and preverify MIDlets that
# retain optional WMA code paths. No SMS/MMS protocol implementation is linked.

SUBSYSTEMS += wma_api
SUBSYSTEM_PROTOCOL_MODULES += wma_api

SUBSYSTEM_WMA_API_SOURCEPATH = \
    $(SUBSYSTEM_DIR)/protocol/wma_api/classes
SUBSYSTEM_WMA_API_PACKAGES = \
    javax.wireless.messaging

MIDP_JAVADOC_SOURCEPATH += $(SUBSYSTEM_WMA_API_SOURCEPATH)
MIDP_JAVADOC_PACKAGES += $(SUBSYSTEM_WMA_API_PACKAGES)
GROUP_PROTOCOL_JAVADOC_PACKAGES += $(SUBSYSTEM_WMA_API_PACKAGES)

SUBSYSTEM_WMA_API_JAVA_FILES = \
    $(SUBSYSTEM_DIR)/protocol/wma_api/classes/javax/wireless/messaging/Message.java \
    $(SUBSYSTEM_DIR)/protocol/wma_api/classes/javax/wireless/messaging/TextMessage.java \
    $(SUBSYSTEM_DIR)/protocol/wma_api/classes/javax/wireless/messaging/BinaryMessage.java \
    $(SUBSYSTEM_DIR)/protocol/wma_api/classes/javax/wireless/messaging/MessageListener.java \
    $(SUBSYSTEM_DIR)/protocol/wma_api/classes/javax/wireless/messaging/MessageConnection.java
