# In-process RGB565 framebuffer backend for the native iOS host.

IOS_NATIVE_FB_PORT_DIR=$(SUBSYSTEM_DIR)/highlevelui/fb_port/ios_native

vpath % $(IOS_NATIVE_FB_PORT_DIR)/native

SUBSYSTEM_APP_NATIVE_FILES += \
    ios_native_port.c

SUBSYSTEM_APP_EXTRA_INCLUDES += \
    -I$(IOS_NATIVE_FB_PORT_DIR)/native

EXTRA_CFLAGS += -DPHONEME_IOS_NATIVE=1
