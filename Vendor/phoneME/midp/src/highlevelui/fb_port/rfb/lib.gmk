# Headless LibVNCServer framebuffer backend.

FB_PORT_DIR=$(SUBSYSTEM_DIR)/highlevelui/fb_port/rfb

RFB_CFLAGS := $(shell pkg-config --cflags libvncserver 2>/dev/null)
RFB_LIBS := $(shell pkg-config --libs libvncserver 2>/dev/null)

ifeq ($(strip $(RFB_LIBS)),)
    RFB_LIBS = -lvncserver -lpthread
endif

vpath % $(FB_PORT_DIR)/native

SUBSYSTEM_APP_NATIVE_FILES += \
    rfb_port.c

SUBSYSTEM_APP_EXTRA_INCLUDES += \
    -I$(FB_PORT_DIR)/native

EXTRA_CFLAGS += $(RFB_CFLAGS) -DPHONEME_RFB
LIBS += $(RFB_LIBS)
