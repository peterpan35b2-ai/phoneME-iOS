# Lightweight iOS JSR-75 FileConnection implementation.
SUBSYSTEMS += fileconnection_compat

SUBSYSTEM_FILECONNECTION_COMPAT_PACKAGES = \
    javax.microedition.io.file com.sun.midp.io.j2me.file

SUBSYSTEM_FILECONNECTION_COMPAT_JAVA_FILES = \
    $(SUBSYSTEM_DIR)/fileconnection_compat/classes/javax/microedition/io/file/FileConnection.java \
    $(SUBSYSTEM_DIR)/fileconnection_compat/classes/javax/microedition/io/file/FileSystemListener.java \
    $(SUBSYSTEM_DIR)/fileconnection_compat/classes/javax/microedition/io/file/FileSystemRegistry.java \
    $(SUBSYSTEM_DIR)/fileconnection_compat/classes/com/sun/midp/io/j2me/file/Protocol.java

SUBSYSTEM_FILECONNECTION_COMPAT_SOURCEPATH = \
    $(SUBSYSTEM_DIR)/fileconnection_compat/classes

SUBSYSTEM_FILECONNECTION_COMPAT_EXTRA_INCLUDES += \
    -I$(SUBSYSTEM_DIR)/core/kni_util/include

SUBSYSTEM_FILECONNECTION_COMPAT_NATIVE_FILES = \
    fileconnection_kni.c

vpath % $(SUBSYSTEM_DIR)/fileconnection_compat/native

MIDP_JAVADOC_SOURCEPATH += $(SUBSYSTEM_FILECONNECTION_COMPAT_SOURCEPATH)
MIDP_JAVADOC_PACKAGES += $(SUBSYSTEM_FILECONNECTION_COMPAT_PACKAGES)
