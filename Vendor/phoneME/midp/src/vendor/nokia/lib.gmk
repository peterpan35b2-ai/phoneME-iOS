# Nokia UI and Sound compatibility API used by many MIDP games.
SUBSYSTEMS += nokia_compat

SUBSYSTEM_NOKIA_COMPAT_PACKAGES = \
    com.nokia.mid.ui com.nokia.mid.sound

SUBSYSTEM_NOKIA_COMPAT_JAVA_FILES = \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes/com/nokia/mid/ui/DeviceControl.java \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes/com/nokia/mid/ui/DirectGraphics.java \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes/com/nokia/mid/ui/DirectGraphicsImpl.java \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes/com/nokia/mid/ui/DirectUtils.java \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes/com/nokia/mid/ui/FullCanvas.java \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes/com/nokia/mid/sound/Sound.java \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes/com/nokia/mid/sound/SoundListener.java

SUBSYSTEM_NOKIA_COMPAT_SOURCEPATH = \
    $(SUBSYSTEM_DIR)/vendor/nokia/classes

SUBSYSTEM_NOKIA_COMPAT_EXTRA_INCLUDES += \
    -I$(SUBSYSTEM_DIR)/core/kni_util/include \
    -I$(SUBSYSTEM_DIR)/lowlevelui/graphics/gx_putpixel/include \
    -I$(SUBSYSTEM_DIR)/lowlevelui/image_api/include \
    -I$(SUBSYSTEM_DIR)/lowlevelui/image/img_putpixel/native

SUBSYSTEM_NOKIA_COMPAT_NATIVE_FILES = \
    nokia_compat_kni.c

vpath % $(SUBSYSTEM_DIR)/vendor/nokia/native

MIDP_JAVADOC_SOURCEPATH += $(SUBSYSTEM_NOKIA_COMPAT_SOURCEPATH)
MIDP_JAVADOC_PACKAGES += $(SUBSYSTEM_NOKIA_COMPAT_PACKAGES)
