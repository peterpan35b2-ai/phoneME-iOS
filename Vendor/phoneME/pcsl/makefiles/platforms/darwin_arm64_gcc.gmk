# PCSL native macOS arm64 platform.

PCSL_OS=darwin
PCSL_CPU=arm64

FILE_MODULE=posix
NETWORK_MODULE=bsd/generic
MEMORY_MODULE=malloc
MEMORY_PORT_MODULE=malloc
PRINT_MODULE=stdout
STRING_MODULE=utf16

# The generic heap-backed chunk implementation is portable to Darwin.
PCSL_CHUNKMEM_IMPL=pcsl_chunkheap
PCSL_CHUNKMEM_DIR=$(PCSL_DIR)/memory/heap

include $(PCSL_DIR)/makefiles/share/gcc.gmk
include $(PCSL_DIR)/makefiles/share/darwin.gmk
